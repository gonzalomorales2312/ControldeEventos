# Archivo /var/www/api/.env en el servidor (NO subir el .env de su PC).
# Genere cada secreto con:  openssl rand -hex 32
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=api_user
DB_PASSWORD=CAMBIAR_CLAVE_LARGA_DE_MYSQL
DB_NAME=api_boletas

# Debe ser IGUAL a 'api_key' en /var/www/eventos/config.php
API_KEY=CAMBIAR_POR_VALOR_ALEATORIO_1
JWT_SECRET=CAMBIAR_POR_VALOR_ALEATORIO_2
JWT_EXPIRES_IN=24h
